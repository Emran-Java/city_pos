<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".dev_rnd.TestActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnTestTransection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >
        <TextView
            android:id="@+id/tvDisplayMessage"
            android:hint="Display message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_margin="20dp"
            />
    </ScrollView>

    <Button
        android:id="@+id/btnTestTransection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test Trnx"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSaleTransection"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"/>
    <Button
        android:id="@+id/btnSaleTransection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sale"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnTestTransection"
        android:layout_margin="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>