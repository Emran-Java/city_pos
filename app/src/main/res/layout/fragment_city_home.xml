<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_background">

    <!--
        <View
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:background="#F51B23"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    -->

    <ImageView
        android:id="@+id/iv_top_left_logo"
        android:layout_width="@dimen/dimnCityHomeTopLeftLogoWH"
        android:layout_height="@dimen/dimnCityHomeTopLeftLogoWH"
        android:layout_marginStart="@dimen/dimnCityRootBorderGap"
        android:layout_marginTop="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mute"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_top_right_logo"
        android:layout_width="@dimen/dimnCityHomeTopRightLogoWH"
        android:layout_height="@dimen/dimnCityHomeTopRightLogoWH"
        android:layout_marginEnd="@dimen/dimnCityRootBorderGap"
        android:src="@drawable/ic_mute"
        app:layout_constraintBottom_toBottomOf="@id/iv_top_left_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_top_left_logo" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/vwBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_left_logo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/base_background">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMerchant"
                style="@style/Widget.CityBank.Card.HomeTopTitle"
                android:layout_marginHorizontal="@dimen/dimnCityCardRootBorderMargin"
                android:layout_marginTop="@dimen/dimnTopCardMarginTop"
                app:cardCornerRadius="@dimen/dimnTopCardRadius"
                app:cardElevation="@dimen/dimnTopCardElevation"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvMerchantName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="City Marchant"
                    android:textColor="@color/dimnTopCardTxtColor"
                    android:textSize="@dimen/dimnTopCardTextSize" />

            </com.google.android.material.card.MaterialCardView>

            <!--================== Slider =================-->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerHomePromo"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimnCityHomeSliderHeight"
                android:layout_marginHorizontal="@dimen/dimnCityCardSliderRootBorderMargin"
                android:layout_marginTop="@dimen/dimnCityHomeSliderMarginVertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMerchant" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:background="#00ffffff"
                app:elevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewPagerHomePromo"
                app:tabIndicatorColor="#E91E24"
                app:tabIndicatorGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="#E91E24"
                app:tabTextColor="#BBBBBB" />

            <!--================== SALE/Top CARD =================-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTopFeatureItem"
                style="@style/Widget.CityBank.Card.HomeTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:layout_marginHorizontal="@dimen/dimnCityCardRootBorderMargin"
                android:layout_marginTop="-16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tabIndicator">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvFeatureTopItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="8dp"
                        android:text="Amount"
                        android:textAllCaps="true"
                        android:textColor="#202020"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/txtAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="TK 0.00"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        app:layout_constraintBottom_toTopOf="@+id/vwBottom"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFeatureTopItem" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_right_arraw"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/vwBottom"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:background="#E91E24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMenuItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/dimnCityCardRootBorderMargin"

                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvTopFeatureItem"
                tools:listitem="@layout/item_report_menu"
                tools:itemCount="4" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!--
        ================== Guideline =================

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        ================== VOID =================

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoid"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvTopFeatureItem" />

        ================== SETTLEMENT =================

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettlement"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/cvTopFeatureItem" />

        ================== LOGON =================

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogon"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardVoid" />

        ================== MORE =================

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMore"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/cardSettlement" />

        ================== Bottom Red Bar =================-->

    <View
        android:id="@+id/vwBottomBar"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="#F51B23"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>