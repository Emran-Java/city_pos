<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <acquire.base.widget.PrimaryToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:layout_gravity="center"
       android:gravity="center"
       android:orientation="vertical">

       <LinearLayout
           android:layout_width="match_parent"
           android:gravity="center_horizontal"
           android:layout_gravity="center"
           android:layout_marginTop="@dimen/dp10"
           android:layout_marginStart="@dimen/dp30"
           android:layout_marginEnd="@dimen/dp30"
           android:layout_height="wrap_content"
           android:orientation="horizontal">
           <ImageView
               android:id="@+id/iv_result"
               android:layout_width="@dimen/dp68"
               android:layout_height="@dimen/dp68"
               android:layout_gravity="center"
               android:src="@drawable/core_result_success" />

           <TextView
               android:id="@+id/tv_message"
               android:layout_width="wrap_content"
               android:layout_height="match_parent"
               android:gravity="center"
               android:textSize="@dimen/sp22"
               android:autoSizeTextType="uniform"
               android:autoSizeMaxTextSize="@dimen/sp22"
               android:autoSizeMinTextSize="@dimen/sp16"
               android:ellipsize="end"
               android:maxLines="2"
               android:text="@string/core_result_success_prompt"/>
       </LinearLayout>

       <com.google.android.material.button.MaterialButton
           android:id="@+id/btn_done"
           android:layout_width="match_parent"
           android:layout_marginStart="@dimen/dp50"
           android:layout_marginEnd="@dimen/dp50"
           android:layout_height="@dimen/base_primary_button_height"
           android:text="@string/base_done" />

       <RelativeLayout
           android:visibility="gone"
           android:id="@+id/ll_receipt"
           android:layout_width="match_parent"
           android:layout_height="match_parent">
           <TextView
               android:id="@+id/tv_receipt_choose_tip"
               android:layout_gravity="center_horizontal"
               android:textSize="@dimen/base_tertiaryTextSize"
               android:visibility="gone"
               android:layout_centerHorizontal="true"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="@dimen/dp5"
               android:text="@string/core_choose_receipt"/>

           <androidx.recyclerview.widget.RecyclerView
               android:layout_below="@id/tv_receipt_choose_tip"
               android:id="@+id/rv_receipt_type"
               android:layout_width="match_parent"
               android:layout_centerInParent="true"
               android:layout_height="match_parent"
               android:layout_marginStart="@dimen/dp2"
               android:layout_marginEnd="@dimen/dp2"
               app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
               app:spanCount="4" />

       </RelativeLayout>
   </LinearLayout>

</LinearLayout>