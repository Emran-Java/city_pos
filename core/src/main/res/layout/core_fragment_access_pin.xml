<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <acquire.base.widget.PrimaryToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_pin_accessibility_mode"
                android:textSize="@dimen/base_secondaryTextSize" />


            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_pan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/base_secondaryTextSize" />
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp8">

            <TextView
                android:id="@+id/tv_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4" />

            <View
                android:layout_width="@dimen/dp197"
                android:layout_height="@dimen/dp1"
                android:background="@android:color/black" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:id="@+id/gl_pin_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/base_underBackground"
        android:columnCount="3"
        android:padding="@dimen/base_keyboard_padding"
        android:layout_weight="2"
        android:rowCount="5">


        <!--===============Row 1===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key1"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key2"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key3"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_3" />


        <!--===============Row 2===================-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key4"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key5"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key6"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_6" />


        <!--===============Row 3===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key7"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key8"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key9"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_9" />

        <!--===============Row 4===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyCancel"
            style="@style/RnibPinCancelButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_rowSpan="2"
            android:text="@string/base_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key0"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyEnter"
            style="@style/RnibPinEnterButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowSpan="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_ok" />
        <!--===============Row 5===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyBack"
            style="@style/RnibPinBackButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_clear"  />
    </GridLayout>

</LinearLayout>