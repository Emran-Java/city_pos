<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_underBackground"
    android:paddingHorizontal="@dimen/dp8"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/dp24"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_msg"
            android:layout_marginStart="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/base_secondaryText" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="0dp"
            app:contentPadding="@dimen/dp8"
            android:layout_marginStart="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp100"
            android:background="@color/base_background">
            <TextView
                android:id="@+id/tv_pin"
                android:gravity="center"
                android:textSize="@dimen/sp40"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/base_underBackground"
        android:columnCount="4"
        android:layout_marginTop="@dimen/dp16"
        android:layout_marginBottom="@dimen/base_keyboard_padding"
        android:rowCount="4">
        <!--===============Row 1===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key1"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key2"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key3"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyCancel"
            style="@style/RnibPinCancelButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="@dimen/sp36"
            android:text="@string/base_cancel" />

        <!--===============Row 2===================-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key4"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key5"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key6"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyBack"
            style="@style/RnibPinBackButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="@dimen/sp36"
            android:text="@string/base_clear"  />
        <!--===============Row 3===================-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/key7"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key8"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key9"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyEnter"
            style="@style/RnibPinEnterButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowSpan="2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="@dimen/sp42"
            android:text="@string/base_ok" />

        <com.google.android.material.button.MaterialButton
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key0"
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="@string/base_keyboard_key_0" />

        <com.google.android.material.button.MaterialButton
            style="@style/RnibPinNumberButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
    </GridLayout>
</LinearLayout>