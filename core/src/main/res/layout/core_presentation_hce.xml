<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/base_gradient_background">


    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp20"
        android:textSize="@dimen/sp80" />

    <com.google.android.material.card.MaterialCardView
        android:layout_centerInParent="true"
        android:id="@+id/cv_container"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/base_background"
        app:cardCornerRadius="@dimen/dp8"
        app:contentPadding="@dimen/dp16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_width="@dimen/dp500"
            android:layout_height="match_parent"
            android:minHeight="@dimen/dp400"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_hce"
                android:src="@drawable/core_hce_tap_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:scaleType="centerCrop" />

            <TextView
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_hce"
                android:layout_marginTop="@dimen/dp20"
                android:text="@string/core_hce_read_device"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>